{# Cookie consent banner — shown on first visit; acceptance stored in localStorage by site.js #}
<div class="pd-cookie" id="pd-cookie" role="dialog" aria-label="Файлы cookie">
  <span class="pd-cookie-ic"><i data-lucide="cookie"></i></span>
  <div class="pd-cookie-text">
    <span>Продолжая пользоваться сайтом, вы соглашаетесь с обработкой cookie и данных в соответствии с <a href="/cookies" target="_blank" rel="noopener">Политикой использования cookie</a> и <a href="/privacy" target="_blank" rel="noopener">Политикой конфиденциальности</a>.</span>
  </div>
  <div class="pd-cookie-actions">
    <a class="pd-cookie-more" href="/cookies" target="_blank" rel="noopener">Подробнее</a>
    <button class="pd-btn pd-btn--primary pd-btn--sm" type="button" data-pd-cookie-accept>Принять</button>
  </div>
</div>
